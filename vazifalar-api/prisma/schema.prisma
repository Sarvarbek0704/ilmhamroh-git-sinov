  foiz             Int      @default(0) @db.SmallInt
  rollar           String[] @default([])
  foydalanuvchilar BigInt[] @default([])
  tavsif           String?
  yangilanganVaqt  DateTime @default(now()) @map("yangilangan_vaqt") @db.Timestamptz(6)

  @@map("bayroqlar")
}
