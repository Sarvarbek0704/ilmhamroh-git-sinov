{
  "name": "vazifalar-api",
  "version": "4.0.1",
  "private": true,
  "description": "vazifalar ilovasining backend'i — REST API (v2: NestJS)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "tip": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run tip && npm run lint && npm test && npm run build",
    "sxema": "node scripts/sxema.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "buyruq": "node --env-file-if-exists=.env dist/buyruq.js",
    "test:qamrov": "vitest run --coverage --coverage.include=\"src/**/*.ts\" --coverage.exclude=\"src/generated/**\" --coverage.exclude=\"src/main.ts\" --coverage.exclude=\"src/buyruq.ts\" --coverage.exclude=\"src/**/*.d.ts\" --coverage.thresholds.lines=90 --coverage.thresholds.branches=80 --coverage.thresholds.functions=90",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "xavfsizlik:audit": "npm audit --omit=dev --audit-level=moderate",
    "ishchi": "node --env-file-if-exists=.env dist/ishchi.js",
    "bot": "node --env-file-if-exists=.env dist/bot.js",
    "mcp": "node --env-file-if-exists=.env dist/mcp.js",
    "test:aralash": "vitest run --sequence.shuffle"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.9",
    "@nestjs/schematics": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@simplewebauthn/browser": "14.0.0",
    "@standard-schema/spec": "1.1.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/archiver": "8.0.0",
    "@types/busboy": "1.5.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "oidc-provider": "9.12.2",
    "pino-pretty": "13.2.0",
    "playwright": "1.64.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
