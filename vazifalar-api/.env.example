# .env.example — namuna (git'da). Node o'zi o'qiydi (--env-file-if-exists); Nest ConfigModule ignoreEnvFile: true. Nusxa: cp .env.example .env  (.env git'ga KIRMAYDI — .gitignore)
# Bu yerda haqiqiy parol/kalit YO'Q va bo'lmasligi kerak. Hamma qiymat src/config.ts da Zod bilan tekshiriladi.

# development | production | test
NODE_ENV=development
PORT=3000
# Faqat lokal. Docker ichida 0.0.0.0 (33-qism)
HOST=127.0.0.1
# Frontend manzillari, vergul bilan (production'da majburiy)
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# xotira | fayl | postgres (pg, 26-qism) | prisma (Prisma 7, 27-qism)
SAQLASH=xotira
FAYL_YOLI=data/vazifalar.json
# SAQLASH=postgres/prisma: lokal trust konteyner (31-qism kanoni: kanon31-pg, 5496) — PAROL YO'Q. Server uchun: postgres://user:<URL-kodlangan parol>@host:5432/baza?sslmode=verify-full
# 30 B (28 BACKLOG 4): ilova SUPERUSER bilan EMAS — vazifalar_api roli (sql/106, 119): RLS ostida, faqat o'z jadvallariga DML. Superuser (postgres)
# RLS'ni chetlab o'tadi (BYPASSRLS) — bitta xato (set_config unutilgan so'rov) hamma foydalanuvchi ma'lumotini ochadi. Migratsiya — vazifalar_migratsiya
# DATABASE_URL=postgres://vazifalar_api@127.0.0.1:5496/vazifalar
# Migratsiya: npm run db:migrate (prisma migrate deploy). Mavjud bazada birinchi marta: npx prisma migrate resolve --applied 0_init
# SAQLASH=xotira/fayl (auth'siz rejim) — qaysi foydalanuvchining vazifalari. postgres/prisma da egasi SESSIYADAN (28-qism)
EGASI_ID=1
# Pool hajmi (instanslar soni × PG_POOL_MAX < max_connections) va so'rov chegarasi (ms)
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT=5000
# Reverse proxy orqasida: proxy'lar soni (1) yoki false
TRUST_PROXY=false
# Foydalanuvchi sanalari (?dan=, ?gacha=) qaysi mintaqada; saqlash — doim UTC
APP_TZ=Asia/Tashkent
# HTTPS orqasida (nginx) true
HSTS=false
# (29-qism / 30 C: WEBHOOK_URL olib tashlandi — har foydalanuvchi o'z webhook'ini POST /v1/webhooklar bilan qo'shadi)
# Redis kesh (ixtiyoriy, 27-qism) va TTL (s)
# REDIS_URL=redis://127.0.0.1:6384
KESH_TTL=60

# ===== 28-qism: autentifikatsiya va xavfsizlik =====
# Ikki rol (sql/119): ma'lumot — vazifalar_api (RLS), auth jadvallari — vazifalar_auth. Berilmasa — bitta pool (DATABASE_URL)
# AUTH_DATABASE_URL=postgres://vazifalar_auth@127.0.0.1:5496/vazifalar
# Ilova siri (>= 32 belgi; HKDF bilan: SMS kod HMAC, kursor, API kalit, TOTP shifri, imzoli cookie'lar). Yaratish:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ILOVA_SIRI=
# Sessiya: eslab qolingan — jimlik (daqiqa) va mutlaq muddat (kun); eslab qolinmagan — "qisqa"
SESSIYA_IDLE_DAQIQA=10080
SESSIYA_MUDDAT_KUN=30
SESSIYA_QISQA_IDLE_DAQIQA=720
SESSIYA_QISQA_MUDDAT_KUN=7
# true — __Host-sessiya (Secure). Faqat http'da sinash uchun false (cookie nomi "sessiya")
COOKIE_SECURE=true
# Xatdagi havolalar (tasdiq, tiklash) — frontend; OIDC qaytish manzili — API
ILOVA_URL=http://localhost:5173
API_URL=http://localhost:3000
# SMS kod yuboriladigan mamlakat prefikslari (vergul bilan) va kunlik global SMS byudjeti (SMS pumping)
OTP_MAMLAKATLAR=+998
SMS_KUNLIK_MAKS=1000
# Google (OIDC) — console.cloud.google.com da OAuth client; bo'lmasa yo'l o'chiq. OIDC_HTTP=true — faqat lokal soxta provayder uchun
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ISSUER=https://accounts.google.com
OIDC_HTTP=false
# Telegram Login / Mini App (BotFather tokeni; bo'lmasa yo'l o'chiq) va auth_date muddati (s)
# TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MUDDAT_S=86400
# Passkey (WebAuthn): RP ID — domen (portsiz), ruxsat etilgan origin'lar vergul bilan
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINLAR=http://localhost:5173
# Cloudflare Turnstile siri (bo'lmasa CAPTCHA o'chiq). Lokal sinov — RASMIY test kaliti 1x0000000000000000000000000000000AA
# (u hostname "example.com" qaytaradi — test kaliti bilan TURNSTILE_HOSTNAME bermang)
# TURNSTILE_SIRI=
# TURNSTILE_HOSTNAME=vazifalar.example
# Servislararo HMAC imzo (POST /v1/ichki/tekshiruv; >= 32 belgi)
# ICHKI_HMAC_SIRI=
# ===== 29-qism integratsiyalari (30 C — Nest: IntegratsiyaModule, config bo'yicha yoqiladi) =====
# Fayl ilovalari — S3 mos ombor (lokal: MinIO 127.0.0.1:5680). S3_BUCKET berilmasa — ilova yo'llari yo'q
# S3_ENDPOINT=http://127.0.0.1:5680
# S3_REGION=us-east-1
# S3_BUCKET=vazifalar
# S3_KALIT=
# S3_SIR=
FAYL_MAKS_MB=10
# SMTP — berilsa tasdiqlash/tiklash xatlari shu orqali (lokal: Mailpit 127.0.0.1:5682); berilmasa log'ga (faqat dev).
# production'da SMTP_HOST majburiy. 587 — STARTTLS (production'da requireTLS), 465 — SMTP_SECURE=true. Ishga tushishda verify() — ishlamasa ilova turmaydi
# SMTP_HOST=127.0.0.1
# SMTP_PORT=4582
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=vazifalar <noreply@vazifalar.example.uz>
# Web Push — VAPID kalitlari (npx web-push generate-vapid-keys --json); berilmasa /v1/push — 404
# VAPID_OCHIQ=
# VAPID_YOPIQ=
VAPID_SUBJECT=mailto:admin@vazifalar.example.uz
# SMS provayderi (Eskiz). Berilmasa OTP kodlar log'ga (dev). Lokal sinov — faqat soxta server (test/soxta/eskiz.ts)
# ESKIZ_URL=https://notify.eskiz.uz
# ESKIZ_EMAIL=
# ESKIZ_PAROL=
ESKIZ_FROM=4546
# Telegram bot (alohida jarayon: npm run bot) — TELEGRAM_BOT_TOKEN (yuqorida) + username (deep link), Redis, ishchi roli
# TELEGRAM_BOT_NOMI=vazifalar_bot
# TELEGRAM_API_ROOT=http://127.0.0.1:4584   # faqat lokal soxta Bot API uchun
# Ishchi jarayon (npm run ishchi): BullMQ worker'lari + outbox relay. vazifalar_ishchi roli (sql/205: BYPASSRLS, auth jadvallarisiz) — superuser EMAS
# ISHCHI_DATABASE_URL=postgres://vazifalar_ishchi@127.0.0.1:5496/vazifalar

# ─── 31-qism: AI (#13–#21) ───
# AI_PROVAYDER: yoq (sukut — AI yo'llari 404) | gemini (sinalgan) | openai (OpenAI-mos: OpenAI, Groq, OpenRouter, Ollama — SINALMAGAN) | anthropic (SINALMAGAN)
# Kalitlar — FAQAT .env da (git'ga emas); hech qachon loglanmaydi. Gemini kaliti: https://aistudio.google.com/apikey
# AI_PROVAYDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=gemini-3.5-flash-lite            # openai/anthropic uchun majburiy
# AI_ZAXIRA_MODEL=                          # 429/5xx/timeout'da bitta qayta urinish shu model bilan (#16)
# AI_EMBEDDING_MODEL=gemini-embedding-2
# AI_TIMEOUT_MS=20000
# AI_QAYTA_URINISH=2
# 32: bitta AI so'rovining umumiy muddati (retry + zaxira shu ichida)
# AI_DEADLINE_MS=25000
# AI_KUNLIK_SOROV=30                        # foydalanuvchi kunlik kvotasi (#19)
# AI_KUNLIK_TOKEN=60000

# ─── 31-qism: prodakshn (#26–#30) ───
# YOPISH_KECHIKISH_MS=5000                 # SIGTERM → /health/ready 503 → shuncha kutib server.close() (balanser trafikni olib tashlasin; k8s preStop o'rnida)
# METRIKA_TOKEN=                           # /metrics uchun Bearer (berilmasa — kirishsiz: faqat ichki tarmoqda ochiq bo'lsin)
